  "components": {
    "schemas": {
      "DeadLetterOutboxEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "outboxMessageId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "messageType": {
            "type": "string"
          },
          "payloadJson": {
            "type": "string"
          },
          "lastError": {
            "type": [
              "null",
              "string"
            ]
          },
          "attemptCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "failedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "requeuedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SyncErpRequest": {
        "required": [
          "endpointId"
        ],
        "type": "object",
        "properties": {
          "endpointId": {
            "type": "string",
            "format": "uuid"
          },
          "purchaseOrderNumber": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateFieldMappingRequest": {
        "required": [
          "sourceField",
          "targetField",
          "isRequired",
          "transformExpression"
        ],
        "type": "object",
        "properties": {
          "sourceField": {
            "type": "string"
          },
          "targetField": {
            "type": "string"
          },
          "isRequired": {
            "type": "boolean"
          },
          "transformExpression": {
            "type": [
              "null",
              "string"
            ]
          }
        }
