{
  "ConnectionStrings": {
    "I2P": ""
  },
  "AllowedHosts": "localhost;*.local",
  "Auth": {
    "Authority": "",
    "Audience": "platform-i2p",
    "RequireHttpsMetadata": true,
    "DevBearerToken": "",
    "DevTenantId": "",
    "DevRoles": [ "Integration.Admin", "Integration.Operator", "Integration.Reader" ],
    "ClientCredentials": {
      "TokenEndpoint": "",
      "StaticBearerCacheSeconds": 300,
      "ClockSkewSeconds": 30
    }
  },
  "Messaging": {
    "RabbitMq": {
      "Host": "",
      "Username": "",
      "Password": ""
    }
  },
  "Outbox": {
    "BatchSize": 50,
    "MaxAttempts": 5,
    "PollIntervalSeconds": 2
  },
  "Resilience": {
    "RetryCount": 3,
    "RetryBaseDelayMs": 200,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerDurationSeconds": 30,
    "TimeoutSeconds": 15
  },
  "RateLimiting": {
    "PermitLimit": 120
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Connectors": {
    "Sap": {
      "BaseAddress": "https://localhost:5101/",
      "SecretReference": "sap:client-secret",
      "PurchaseOrdersPath": "api/purchaseOrders",
      "HealthPath": "api/health"
    },
    "Mes": {
      "BaseAddress": "https://localhost:5102/",
      "SecretReference": "mes:client-secret"
    },
    "Cmms": {
      "BaseAddress": "https://localhost:5103/",
      "SecretReference": "cmms:client-secret"
    },
    "Gis": {
      "BaseAddress": "https://localhost:5104/",
      "SecretReference": "gis:client-secret"
    },
    "Lims": {
      "BaseAddress": "https://localhost:5105/",
      "SecretReference": "lims:client-secret"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
